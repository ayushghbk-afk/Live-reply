     val context = LocalContext.current
     val running = LiveReplyAccessibilityService.isRunning()
     var showAutoDisclosure by remember { mutableStateOf(false) }
+    val aiConfigured = settings.primaryModel.isNotBlank() && viewModel.hasApiKey()
+
+    // The #1 "it does nothing" cause: setup finished without a model and API key, so
+    // every detected message ends in "No model configured". Say so here, up front.
+    if (!aiConfigured) {
+        Card(modifier = Modifier.fillMaxWidth()) {
+            Column(modifier = Modifier.padding(12.dp)) {
+                Text(
+                    text = "AI is not configured yet",
+                    fontWeight = FontWeight.Bold,
+                    color = MaterialTheme.colorScheme.error
+                )
+                Text(
+                    text = buildString {
+                        if (settings.primaryModel.isBlank()) append("No model selected. ")
+                        if (!viewModel.hasApiKey()) append("No API key saved. ")
+                        append("The assistant cannot generate replies until both are set.")
+                    },
+                    fontSize = 12.sp
+                )
+                Button(
+                    onClick = { onNavigate("ai") },
+                    modifier = Modifier.fillMaxWidth()
+                ) { Text("Open AI settings") }
+            }
+        }
+    }
 
     SectionCard(title = "Status") {
         StatusLine("Service", if (running) "Running" else "Not connected")
