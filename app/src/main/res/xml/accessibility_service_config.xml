<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility service configuration.

  Deliberately conservative: content-changed and window-state events only, a 100ms
  notification timeout (the app debounces further in code), no key event filtering and
  no touch exploration. Gestures are enabled only so an explicitly user configured
  coordinate fallback can be performed.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagReportViewIds"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.liveaireply.app.MainActivity"
    android:summary="@string/accessibility_service_summary" />
