 .../AccessibilityAutomationController.kt      | 29 +++---
 .../LiveReplyAccessibilityService.kt          | 89 ++++++++++++++-----
 .../app/conversation/ConversationDetector.kt  | 32 ++++++-
 .../app/engine/AssistantRuntime.kt            | 22 +++++
 .../app/engine/AssistantService.kt            | 54 ++++++++++-
 .../app/notifications/MonitoringNotifier.kt   | 34 +++++--
