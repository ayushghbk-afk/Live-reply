<?xml version="1.0" encoding="utf-8"?>
<!--
  Live AI Reply - manifest.

  Permission audit (see README -> "Permissions"): every permission declared here is used
  by code in this repository, and nothing else is requested.

  Deliberately NOT requested, and why:

    * QUERY_ALL_PACKAGES - no code path enumerates installed apps. Package names come from
      the user's explicit enabled-app list and are matched against accessibility events.
    * RECEIVE_SMS / READ_SMS - the app never reads messages; it reads text that is already
      rendered on screen.
    * BIND_NOTIFICATION_LISTENER_SERVICE / NOTIFICATION_LISTENER - no notification access.
    * REQUEST_IGNORE_BATTERY_OPTIMIZATIONS - Security & Settings opens the general system
      battery-optimisation list instead, which needs no permission.
    * MANAGE_EXTERNAL_STORAGE / storage, REQUEST_INSTALL_PACKAGES, SMS, contacts, phone,
      location, RECORD_AUDIO and CAMERA - none of these data sources or actions are used.

  Accessibility, overlay and MediaProjection are high-risk capabilities that can trigger
  Android/Google Play review or warnings. Accessibility is core to this product and the
  other two are optional, so each is declared openly rather than hidden. A transparent,
  correctly signed build is not a guarantee of warning-free installation or Play approval.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reaching the AI endpoint the user configured, and knowing when there is no network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The persistent monitoring notification (Android 13+ needs the runtime grant). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- For AssistantService: an accessibility-driven assistant with an overlay. The
         manifest property below states the subtype, which Android 14+ shows to the user. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Only used while the optional OCR fallback holds a MediaProjection session. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- The floating control. Granted explicitly by the user in system Settings
         ("Display over other apps"); it is never granted silently. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".LiveReplyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveAIReply"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LiveAIReply">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The assistant's foreground service.

          Android 14+ requires a foreground service type; "specialUse" is the correct
          classification for an accessibility-driven assistant that also draws an
          overlay, and the subtype property below states exactly what it is for.
        -->
        <service
            android:name=".engine.AssistantService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live conversation assistant: reads selected visible chat text through Accessibility, drafts a reply with the user-configured AI endpoint, and shows it in the app or optional user-enabled overlay." />
        </service>

        <!-- One-shot, on-device OCR fallback. Started only with the RESULT_OK token from
             Android's MediaProjection dialog and stopped after the authorized frame. -->
        <service
            android:name=".ocr.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          The accessibility service: the only component that can read another app's
          screen, and the reason this app exists. Android starts it only after the user
          switches it on in Settings -> Accessibility -> Downloaded services, and the
          capability is described in full by the strings in res/values/strings.xml.

          Two things are stated honestly rather than hidden:

          1. The service is NOT declared as an accessibility tool. The
             `isAccessibilityTool` flag lives in the service metadata file
             (res/xml/accessibility_service_config.xml), where it is explicitly false -
             which is also the platform default. This app is a conversation assistant,
             not a tool for people with disabilities, so it must not claim that
             designation. Claiming disability-tool status here would be inaccurate and
             deceptive; the in-app and Android service descriptions instead explain the
             conversation-assistant behavior directly.

          2. Event delivery is package-scoped. The metadata starts with the three default
             chat packages and the service updates AccessibilityServiceInfo.packageNames to
             exactly the user's enabled package list at runtime. An empty list is never
             represented as null (which would mean all apps). Sensitive/excluded screens
             are rejected before conversation extraction.
        -->
        <service
            android:name=".accessibility.LiveReplyAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
