<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal AccessibilityService capabilities for Live AI Reply.

  Events are limited to window/content/text changes. Window content and view IDs are
  required to identify visible chat bubbles, the composer and a labelled Send control.
  Key filtering, touch exploration, gesture dispatch and interactive-window enumeration
  are not requested. ACTION_SET_TEXT and ACTION_CLICK on identified nodes do not require
  canPerformGestures.

  The package list below is the safe first-start scope. Once connected, the service updates
  AccessibilityServiceInfo.packageNames to exactly the packages selected by the user. A
  blank selection never becomes an unrestricted/null package list.

  isAccessibilityTool is false because this is a conversation assistant, not a tool whose
  primary purpose is disability support. The label, summary and long description disclose
  what is read, processed, typed and sent.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagIncludeNotImportantViews|flagReportViewIds"
    android:packageNames="com.whatsapp,org.telegram.messenger,com.instagram.android"
    android:canPerformGestures="false"
    android:isAccessibilityTool="false"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.liveaireply.app.MainActivity"
    android:summary="@string/accessibility_service_summary" />
